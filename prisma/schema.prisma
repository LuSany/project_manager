generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ReviewTypeConfig {
  id               String             @id
  name             String             @unique
  displayName      String
  description      String?
  isSystem         Boolean            @default(false)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  review_templates review_templates[]
  reviews          reviews[]
}

model ai_configs {
  id        String     @id
  name      String     @unique
  provider  AIProvider @default(OPENAI)
  apiKey    String?
  baseUrl   String?
  model     String     @default("gpt-4o-mini")
  isActive  Boolean    @default(true)
  isDefault Boolean    @default(false)
  config    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime
}

model ai_logs {
  id           String        @id
  serviceType  AIServiceType
  provider     String
  model        String
  prompt       String
  response     String?
  status       AIStatus      @default(PENDING)
  errorMessage String?
  duration     Int?
  userId       String?
  projectId    String?
  externalId   String?
  createdAt    DateTime      @default(now())

  @@index([serviceType, createdAt])
}

model ai_response_cache {
  id          String        @id
  cacheKey    String        @unique
  serviceType AIServiceType
  requestHash String
  response    String
  hitCount    Int           @default(0)
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime

  @@index([expiresAt])
  @@index([serviceType, requestHash])
}

model audit_logs {
  id          String      @id
  userId      String
  action      AuditAction
  entityType  String
  entityId    String?
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}

model email_configs {
  id           String   @id
  name         String   @unique
  provider     String
  apiKey       String?
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String?
  fromAddress  String
  fromName     String?
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model email_logs {
  id           String      @id
  userId       String?
  projectId    String?
  to           String
  subject      String
  content      String
  templateType String?
  status       EmailStatus @default(PENDING)
  errorMessage String?
  externalId   String?
  sentAt       DateTime?
  createdAt    DateTime    @default(now())
}

model email_templates {
  id        String   @id
  name      String   @unique
  type      String
  subject   String
  body      String
  variables String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model file_storage {
  id                                   String    @id
  fileName                             String
  originalName                         String
  filePath                             String
  fileSize                             Int
  mimeType                             String
  uploadedBy                           String
  createdAt                            DateTime  @default(now())
  documentKey                          String?   @unique
  lockExpiresAt                        DateTime?
  lockedAt                             DateTime?
  lockedBy                             String?
  updatedAt                            DateTime  @default(now())
  version                              Int       @default(1)
  users_file_storage_lockedByTousers   users?    @relation("file_storage_lockedByTousers", fields: [lockedBy], references: [id])
  users_file_storage_uploadedByTousers users     @relation("file_storage_uploadedByTousers", fields: [uploadedBy], references: [id])

  @@index([createdAt])
  @@index([documentKey])
  @@index([lockedBy])
  @@index([uploadedBy])
}

model issues {
  id            String        @id
  title         String
  description   String?
  status        IssueStatus   @default(OPEN)
  priority      IssuePriority @default(MEDIUM)
  projectId     String
  requirementId String?
  autoClose     Boolean       @default(true)
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  projects      projects      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirements  requirements? @relation(fields: [requirementId], references: [id])
  tasks         tasks[]

  @@index([priority])
  @@index([projectId])
  @@index([requirementId])
  @@index([status])
}

model milestones {
  id          String          @id
  title       String
  description String?
  status      MilestoneStatus @default(NOT_STARTED)
  progress    Int             @default(0)
  dueDate     DateTime?
  projectId   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime
  projects    projects        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       tasks[]

  @@index([projectId])
  @@index([status])
}

model notification_ignores {
  userId    String
  projectId String
  createdAt DateTime @default(now())
  projects  projects @relation(fields: [projectId], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model notification_preferences {
  userId    String
  type      NotificationType
  enabled   Boolean             @default(true)
  channel   NotificationChannel @default(IN_APP)
  createdAt DateTime            @default(now())
  users     users               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type, channel])
}

model notifications {
  id        String           @id
  type      NotificationType
  title     String
  content   String
  link      String?
  isRead    Boolean          @default(false)
  userId    String
  projectId String?
  createdAt DateTime         @default(now())
  users     users            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([isRead])
  @@index([userId])
}

model password_reset_tokens {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model preview_service_configs {
  id          String             @id
  serviceType PreviewServiceType
  endpoint    String
  isEnabled   Boolean            @default(true)
  config      String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime
}

model project_members {
  projectId String
  userId    String
  role      ProjectMemberRole
  joinedAt  DateTime          @default(now())
  projects  projects          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  users     users             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model projects {
  id                   String                 @id
  name                 String
  description          String?
  status               ProjectStatus          @default(PLANNING)
  startDate            DateTime?
  endDate              DateTime?
  ownerId              String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  issues               issues[]
  milestones           milestones[]
  notification_ignores notification_ignores[]
  project_members      project_members[]
  users                users                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requirements         requirements[]
  reviews              reviews[]
  risks                risks[]
  tasks                tasks[]

  @@index([ownerId])
  @@index([status])
}

model proposals {
  id             String         @id
  requirementId  String
  userId         String
  content        String
  estimatedHours Float?
  estimatedCost  Float?
  status         ProposalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  requirements   requirements   @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  users          users          @relation(fields: [userId], references: [id])

  @@index([requirementId])
  @@index([status])
  @@index([userId])
}

model requirement_acceptances {
  id            String           @id
  requirementId String
  userId        String
  result        AcceptanceResult @default(PENDING)
  notes         String?
  createdAt     DateTime         @default(now())
  requirements  requirements     @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  users         users            @relation(fields: [userId], references: [id])

  @@index([requirementId])
  @@index([result])
  @@index([userId])
}

model requirement_discussions {
  id            String       @id
  requirementId String
  userId        String
  content       String
  taskId        String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  requirements  requirements @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  tasks         tasks?       @relation(fields: [taskId], references: [id])
  users         users        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@index([userId])
}

model requirement_history {
  id            String       @id
  requirementId String
  changeType    String
  oldValue      String?
  newValue      String?
  changedBy     String
  changeReason  String?
  createdAt     DateTime     @default(now())
  requirements  requirements @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([changeType])
  @@index([requirementId])
}

model requirement_impacts {
  id            String         @id
  requirementId String
  description   String
  severity      ImpactSeverity @default(MEDIUM)
  createdAt     DateTime       @default(now())
  requirements  requirements   @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@index([severity])
}

model requirements {
  id                      String                    @id
  title                   String
  description             String?
  status                  RequirementStatus         @default(PENDING)
  priority                RequirementPriority       @default(MEDIUM)
  projectId               String
  reviewedBy              String?
  reviewedAt              DateTime?
  rejectReason            String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  issues                  issues[]
  proposals               proposals[]
  requirement_acceptances requirement_acceptances[]
  requirement_discussions requirement_discussions[]
  requirement_history     requirement_history[]
  requirement_impacts     requirement_impacts[]
  projects                projects                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  users                   users?                    @relation(fields: [reviewedBy], references: [id])

  @@index([priority])
  @@index([projectId])
  @@index([reviewedBy])
  @@index([status])
}

model review_ai_analysis {
  id           String   @id
  reviewId     String
  analysisType String
  result       String
  aiConfigId   String?
  duration     Int?
  createdAt    DateTime @default(now())

  @@index([reviewId, analysisType])
}

model review_comments {
  id                    String            @id
  reviewId              String
  materialId            String?
  itemId                String?
  parentId              String?
  authorId              String
  content               String
  status                CommentStatus     @default(OPEN)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime
  users                 users             @relation(fields: [authorId], references: [id])
  review_items          review_items?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  review_materials      review_materials? @relation(fields: [materialId], references: [id], onDelete: Cascade)
  review_comments       review_comments?  @relation("review_commentsToreview_comments", fields: [parentId], references: [id], onDelete: Cascade)
  other_review_comments review_comments[] @relation("review_commentsToreview_comments")
  reviews               reviews           @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([materialId])
  @@index([parentId])
  @@index([reviewId])
}

model review_criteria {
  id          String   @id
  reviewId    String
  title       String
  description String?
  weight      Float    @default(1.0)
  maxScore    Float    @default(10)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  reviews     reviews  @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model review_group_members {
  id            String                @id
  groupId       String
  userId        String
  role          ReviewParticipantRole @default(REVIEWER)
  createdAt     DateTime              @default(now())
  review_groups review_groups         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  users         users                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model review_groups {
  id                   String                 @id
  name                 String
  description          String?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  createdById          String
  review_group_members review_group_members[]

  @@index([createdById])
  @@index([isActive])
}

model review_items {
  id              String            @id
  reviewId        String
  title           String
  description     String?
  category        String?
  isRequired      Boolean           @default(false)
  order           Int               @default(0)
  createdAt       DateTime          @default(now())
  review_comments review_comments[]
  reviews         reviews           @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model review_materials {
  id              String            @id
  reviewId        String
  fileId          String
  fileName        String
  fileType        String
  fileSize        Int
  uploadedAt      DateTime          @default(now())
  uploaderId      String
  review_comments review_comments[]
  reviews         reviews           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  users           users             @relation(fields: [uploaderId], references: [id])

  @@index([reviewId])
  @@index([uploaderId])
}

model review_participants {
  reviewId String
  userId   String
  role     ReviewParticipantRole
  joinedAt DateTime              @default(now())
  reviews  reviews               @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  users    users                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
}

model review_template_items {
  id               String           @id
  templateId       String
  title            String
  content          String?
  order            Int              @default(0)
  required         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  review_templates review_templates @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model review_templates {
  id                    String                  @id
  typeId                String
  name                  String
  description           String?
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  review_template_items review_template_items[]
  ReviewTypeConfig      ReviewTypeConfig        @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([typeId])
}

model review_votes {
  reviewId String
  userId   String
  agreed   Boolean
  votedAt  DateTime @default(now())
  reviews  reviews  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  users    users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
}

model reviews {
  id                  String                @id
  title               String
  description         String?
  projectId           String
  typeId              String
  scheduledAt         DateTime?
  status              ReviewStatus          @default(PENDING)
  passedCriteria      Int                   @default(0)
  totalScore          Float?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  authorId            String
  review_comments     review_comments[]
  review_criteria     review_criteria[]
  review_items        review_items[]
  review_materials    review_materials[]
  review_participants review_participants[]
  review_votes        review_votes[]
  users               users                 @relation(fields: [authorId], references: [id])
  projects            projects              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ReviewTypeConfig    ReviewTypeConfig      @relation(fields: [typeId], references: [id])

  @@index([authorId])
  @@index([projectId])
  @@index([status])
  @@index([typeId])
}

model risk_tasks {
  id           String   @id
  riskId       String
  taskId       String
  relationType String   @default("RELATED")
  createdAt    DateTime @default(now())
  risks        risks    @relation(fields: [riskId], references: [id], onDelete: Cascade)
  tasks        tasks    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([riskId])
  @@index([taskId])
}

model risks {
  id             String       @id
  projectId      String
  title          String
  description    String?
  category       RiskCategory @default(TECHNICAL)
  probability    Int          @default(1)
  impact         Int          @default(1)
  riskLevel      RiskLevel    @default(LOW)
  status         RiskStatus   @default(IDENTIFIED)
  progress       Int          @default(0)
  mitigation     String?
  contingency    String?
  ownerId        String
  isAiIdentified Boolean      @default(false)
  aiRiskScore    Float?
  aiSuggestion   String?
  identifiedDate DateTime     @default(now())
  dueDate        DateTime?
  resolvedDate   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  risk_tasks     risk_tasks[]
  users          users        @relation(fields: [ownerId], references: [id])
  projects       projects     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([riskLevel])
  @@index([status])
}

model scheduled_jobs {
  id          String     @id
  name        String     @unique
  description String?
  cron        String
  endpoint    String
  method      String     @default("POST")
  payload     String?
  isActive    Boolean    @default(true)
  lastRunAt   DateTime?
  lastStatus  JobStatus?
  lastError   String?
  createdBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime

  @@index([isActive])
  @@index([lastRunAt])
}

model subtasks {
  id             String     @id
  title          String
  description    String?
  completed      Boolean    @default(false)
  taskId         String
  parentId       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  subtasks       subtasks?  @relation("subtasksTosubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  other_subtasks subtasks[] @relation("subtasksTosubtasks")
  tasks          tasks      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([completed])
  @@index([parentId])
  @@index([taskId])
}

model tags {
  id        String      @id
  name      String      @unique
  color     String      @default("#3B82F6")
  createdAt DateTime    @default(now())
  updatedAt DateTime
  task_tags task_tags[]

  @@index([name])
}

model task_assignees {
  taskId     String
  userId     String
  assignedAt DateTime @default(now())
  tasks      tasks    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  users      users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model task_dependencies {
  id                                         String         @id
  taskId                                     String
  dependsOnId                                String
  dependencyType                             DependencyType @default(FINISH_TO_START)
  createdAt                                  DateTime       @default(now())
  tasks_task_dependencies_dependsOnIdTotasks tasks          @relation("task_dependencies_dependsOnIdTotasks", fields: [dependsOnId], references: [id], onDelete: Cascade)
  tasks_task_dependencies_taskIdTotasks      tasks          @relation("task_dependencies_taskIdTotasks", fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
  @@index([taskId])
}

model task_progress_history {
  id               String   @id
  taskId           String
  progress         Int
  status           String?
  comment          String?
  previousProgress Int?
  userId           String
  createdAt        DateTime @default(now())
  tasks            tasks    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  users            users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

model task_tags {
  taskId    String
  tagId     String
  createdAt DateTime @default(now())
  tags      tags     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tasks     tasks    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

model task_comments {
  id        String   @id
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime
  tasks     tasks    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

model task_templates {
  id           String   @id
  title        String
  description  String?
  templateData String
  isPublic     Boolean  @default(false)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([createdBy])
  @@index([isPublic])
}

model task_watchers {
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  tasks     tasks    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model tasks {
  id                                                     String                    @id
  title                                                  String
  description                                            String?
  status                                                 TaskStatus                @default(TODO)
  progress                                               Int                       @default(0)
  priority                                               TaskPriority              @default(MEDIUM)
  startDate                                              DateTime?
  dueDate                                                DateTime?
  estimatedHours                                         Float?
  actualHours                                            Float?
  projectId                                              String
  milestoneId                                            String?
  issueId                                                String?
  acceptorId                                             String?
  completedAt                                            DateTime?
  createdAt                                              DateTime                  @default(now())
  updatedAt                                              DateTime
  requirement_discussions                                requirement_discussions[]
  risk_tasks                                             risk_tasks[]
  subtasks                                               subtasks[]
  task_assignees                                         task_assignees[]
  task_dependencies_task_dependencies_dependsOnIdTotasks task_dependencies[]       @relation("task_dependencies_dependsOnIdTotasks")
  task_dependencies_task_dependencies_taskIdTotasks      task_dependencies[]       @relation("task_dependencies_taskIdTotasks")
  task_progress_history                                  task_progress_history[]
  task_tags                                              task_tags[]
  task_watchers                                          task_watchers[]
  task_comments                                          task_comments[]
  users                                                  users?                    @relation(fields: [acceptorId], references: [id])
  issues                                                 issues?                   @relation(fields: [issueId], references: [id])
  milestones                                             milestones?               @relation(fields: [milestoneId], references: [id])
  projects                                               projects                  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([acceptorId])
  @@index([completedAt])
  @@index([issueId])
  @@index([milestoneId])
  @@index([priority])
  @@index([projectId])
  @@index([status])
}

model users {
  id                                          String                     @id
  email                                       String                     @unique
  passwordHash                                String
  name                                        String
  avatar                                      String?
  phone                                       String?
  department                                  String?
  position                                    String?
  status                                      UserStatus                 @default(PENDING)
  role                                        SystemRole                 @default(EMPLOYEE)
  createdAt                                   DateTime                   @default(now())
  updatedAt                                   DateTime
  file_storage_file_storage_lockedByTousers   file_storage[]             @relation("file_storage_lockedByTousers")
  file_storage_file_storage_uploadedByTousers file_storage[]             @relation("file_storage_uploadedByTousers")
  notification_ignores                        notification_ignores[]
  notification_preferences                    notification_preferences[]
  notifications                               notifications[]
  password_reset_tokens                       password_reset_tokens[]
  project_members                             project_members[]
  projects                                    projects[]
  proposals                                   proposals[]
  requirement_acceptances                     requirement_acceptances[]
  requirement_discussions                     requirement_discussions[]
  requirements                                requirements[]
  review_comments                             review_comments[]
  review_group_members                        review_group_members[]
  review_materials                            review_materials[]
  review_participants                         review_participants[]
  review_votes                                review_votes[]
  reviews                                     reviews[]
  risks                                       risks[]
  task_assignees                              task_assignees[]
  task_progress_history                       task_progress_history[]
  task_watchers                               task_watchers[]
  task_comments                               task_comments[]
  tasks                                       tasks[]

  @@index([email])
}

model webhook_deliveries {
  id           String                @id
  webhookId    String
  event        String
  payload      String
  status       WebhookDeliveryStatus @default(PENDING)
  statusCode   Int?
  response     String?
  errorMessage String?
  attemptedAt  DateTime              @default(now())
  deliveredAt  DateTime?
  webhooks     webhooks              @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([attemptedAt])
  @@index([status])
  @@index([webhookId])
}

model webhooks {
  id                 String               @id
  name               String
  url                String
  events             String
  secret             String?
  isActive           Boolean              @default(true)
  createdBy          String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  webhook_deliveries webhook_deliveries[]

  @@index([createdBy])
  @@index([isActive])
}

